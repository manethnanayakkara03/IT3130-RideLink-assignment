          "name": "Get Receipt by Payment ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{fareServiceUrl}}/api/receipts/{{paymentId}}", "host": ["{{fareServiceUrl}}"], "path": ["api", "receipts", "{{paymentId}}"] }
          }
        },
        {
          "name": "Get Receipt by Ride ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{fareServiceUrl}}/api/receipts/ride/{{rideId}}", "host": ["{{fareServiceUrl}}"], "path": ["api", "receipts", "ride", "{{rideId}}"] }
          }
        }
      ]
    },
    {
      "name": "11 Negative Tests",
      "item": [
        {
          "name": "Negative 1 - Duplicate Email Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Perera\",\n  \"email\": \"nimal.passenger@example.com\",\n  \"phone\": \"0771234567\",\n  \"password\": \"Pass1234!\"\n}"
            },
            "url": { "raw": "{{accountServiceUrl}}/api/auth/register/passenger", "host": ["{{accountServiceUrl}}"], "path": ["api", "auth", "register", "passenger"] }
          }
        },
        {
          "name": "Negative 2 - Invalid Login Bad Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nimal.passenger@example.com\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": { "raw": "{{accountServiceUrl}}/api/auth/login", "host": ["{{accountServiceUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Negative 3 - Invalid Ride Lifecycle Transition (Complete when not IN_PROGRESS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": { "raw": "{{rideServiceUrl}}/api/rides/{{rideId}}/complete", "host": ["{{rideServiceUrl}}"], "path": ["api", "rides", "{{rideId}}", "complete"] }
          }
        },
        {
          "name": "Negative 4 - Simulate Payment Authorization Failure",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment status is FAILED', function () { pm.expect(pm.response.json().status).to.eql('FAILED'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rideId\": 999,\n  \"passengerId\": 1,\n  \"amount\": 500.0,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"simulateFailure\": true\n}"
            },
            "url": { "raw": "{{fareServiceUrl}}/api/payments", "host": ["{{fareServiceUrl}}"], "path": ["api", "payments"] }
          }
        },
        {
          "name": "Negative 5 - Non-existent Ride ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404 Not Found', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{rideServiceUrl}}/api/rides/99999", "host": ["{{rideServiceUrl}}"], "path": ["api", "rides", "99999"] }
          }
        }
      ]
    }
  ]
}
