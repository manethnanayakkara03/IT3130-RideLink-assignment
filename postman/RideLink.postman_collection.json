              "mode": "raw",
              "raw": "{\n  \"rideId\": {{rideId}},\n  \"passengerId\": {{passengerId}},\n  \"amount\": 830.0,\n  \"paymentMethod\": \"SIMULATED_CARD\",\n  \"simulateFailure\": false\n}"
            },
            "url": { "raw": "{{fareServiceUrl}}/api/payments", "host": ["{{fareServiceUrl}}"], "path": ["api", "payments"] }
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{fareServiceUrl}}/api/payments/{{paymentId}}", "host": ["{{fareServiceUrl}}"], "path": ["api", "payments", "{{paymentId}}"] }
          }
        },
        {
          "name": "Get Payment for Ride",
          "request": {
            "method": "GET",
            "url": { "raw": "{{fareServiceUrl}}/api/payments/ride/{{rideId}}", "host": ["{{fareServiceUrl}}"], "path": ["api", "payments", "ride", "{{rideId}}"] }
          }
